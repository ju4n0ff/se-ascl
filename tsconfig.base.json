{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@senascl/shared-types": ["./packages/shared-types/src"],
      "@senascl/core-ml": ["./packages/core-ml/src"],
      "@senascl/landmarks": ["./packages/landmarks/src"],
      "@senascl/nlp-lsch": ["./packages/nlp-lsch/src"],
      "@senascl/tts": ["./packages/tts/src"],
      "@senascl/ui-kit": ["./packages/ui-kit/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
