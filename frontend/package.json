{
  "name": "senacl-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run verificar && ng test --watch=false",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "verificar": "node scripts/verificar-capas.mjs",
    "test:watch": "ng test --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource/epilogue": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@mediapipe/holistic": "0.5.1675471629",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "SeñaCL: traductor LSCh en tiempo real (Angular)",
  "engines": {
    "node": ">=24"
  }
}
