# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/signia

# Sync URL for alembic/scripts
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/signia

# JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Modelos (rutas relativas a backend/ o absolutas)
# Modelo LSCh v3 oficial; el legado dynamic_lstm.h5 ya no se acepta.
DYNAMIC_MODEL_PATH=models/mejor_modelo_lsch.keras
LABELS_PATH=models/etiquetas_lsch.json
FEATURES_CONFIG_PATH=models/config_features.json
# Opcional: si no existe, el modo 'static' queda deshabilitado
STATIC_MODEL_PATH=models/static_svm.joblib

# Inferencia
UMBRAL_CONFIANZA=0.55
MAX_CONCURRENT_INFERENCES=2

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
