# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/signia

# Sync URL for alembic/scripts
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/signia

# JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Legacy/simple models (optional)
STATIC_MODEL_PATH=models/static_svm.joblib
DYNAMIC_MODEL_PATH=models/dynamic_lstm.h5
LABELS_PATH=models/labels.json

# LSCh v3 production model (defaults resolve relative to repo; override if needed)
# LSCH_MODEL_PATH=../conversor/modelos/mejor_modelo_lsch.keras
# LSCH_LABELS_PATH=../conversor/modelos/etiquetas_lsch.json
# LSCH_CONFIG_PATH=../conversor/modelos/config_features.json
# LSCH_FEATURES_MODULE=../conversor
LSCH_CONFIDENCE_THRESHOLD=0.55

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
