# Database (local)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/signia
# Supabase: usar el Pooler (IPv4), copiado de Connect > Transaction pooler (6543) o Session pooler (5432).
# También se aceptan postgres:// y postgresql://. Codificar los caracteres especiales de la contraseña (@ = %40).
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:6543/postgres

# Sync URL for alembic/scripts
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/signia

# Conexión. Vacío = automático: SSL si el host es de Supabase o la URL trae sslmode=require;
# PgBouncer si el host es *.pooler.supabase.com o el puerto es 6543. true/false explícito siempre gana.
DB_SSL=
DB_USE_PGBOUNCER=
# Opcional: ruta a la CA de Supabase (Database Settings > SSL) para verificar el certificado del servidor
DB_SSL_ROOT_CERT=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_S=300

# JWT (algoritmo fijo HS256)
# Con DEBUG=false el servidor NO arranca si SECRET_KEY es débil (< 32 caracteres) o el valor de ejemplo.
# Generar: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Modelos (rutas relativas a backend/ o absolutas)
# Modelo LSCh v3 oficial; el legado dynamic_lstm.h5 ya no se acepta.
DYNAMIC_MODEL_PATH=models/mejor_modelo_lsch.keras
LABELS_PATH=models/etiquetas_lsch.json
FEATURES_CONFIG_PATH=models/config_features.json
# Opcional: si no existe, el modo 'static' queda deshabilitado
STATIC_MODEL_PATH=models/static_svm.joblib

# Inferencia
UMBRAL_CONFIANZA=0.55
MAX_CONCURRENT_INFERENCES=2
# Hashes Argon2id simultáneos (64 MiB cada uno); 1 en instancias de 512 MB
MAX_CONCURRENT_HASHES=2

# CORS y Origin del WebSocket (separados por comas, sin '*'). Con DEBUG=false se exige https://,
# salvo loopback. Nube: ALLOWED_ORIGINS=https://senacl.vercel.app,https://www.senacl.cl
ALLOWED_ORIGINS=http://localhost:4200
# Opcional (previews de Vercel). Patrón cerrado, nunca .*  Ejemplo:
# ALLOWED_ORIGIN_REGEX=^https://senacl-[a-z0-9-]+-miequipo\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Proxies inversos confiables (0 a 5). 0 en local: se ignora X-Forwarded-For.
# En Render ver backend/README.md: un valor mayor al real permite falsificar la IP.
TRUST_PROXY_HOPS=0

# Límites anti-DoS
MAX_BODY_BYTES=5242880
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=3
RATE_LIMIT_PROFILE_PER_MIN=5
RATE_LIMIT_RECOGNIZE_PER_MIN=30
WS_MAX_MESSAGE_BYTES=49152
WS_MAX_CONNECTIONS_PER_IP=5
WS_MAX_MESSAGES_PER_SEC=35
WS_IDLE_TIMEOUT_S=60

# Server
HOST=127.0.0.1
PORT=8000
# false por defecto: sin /docs, con HSTS y Origin obligatorio en el WebSocket
DEBUG=false
